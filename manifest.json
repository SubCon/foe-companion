{
    "manifest_version": 3,
    "name": "FoE Companion",
    "version": "1.1.1",
    "description": "Personal add-ons that work alongside FoE Hammer and FoE Helper",
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "icons": {
        "16":  "icons/icon-16.png",
        "48":  "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "web_accessible_resources": [{
        "resources": ["icons/exclamation-warning-red.svg"],
        "matches":   ["https://*.forgeofempires.com/*"]
    }],
    "permissions": ["storage"],
    "content_scripts": [
        {
            "matches": ["https://*.forgeofempires.com/*"],
            "include_globs": ["*forgeofempires.com/game*"],
            "js": ["settings-bridge.js"],
            "run_at": "document_start"
        },
        {
            "matches": ["https://*.forgeofempires.com/*"],
            "include_globs": ["*forgeofempires.com/game*"],
            "js": [
                "modules/text-select.js",
                "modules/all-buildings.js",
                "modules/ge-marker.js",
                "companion.js"
            ],
            "world": "MAIN",
            "run_at": "document_start"
        }
    ]
}
